{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".eve/**", ".output/**", ".vercel/output/**"]
		},
		"check-types": {
			"dependsOn": ["topo", "^build"]
		},
		"dev": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"cache": false,
			"interactive": true,
			"persistent": true,
			"passThroughEnv": [
				"AGENT_BRIDGE_SECRET",
				"GSI_MODEL_GATEWAY_BASE_URL",
				"GSI_MODEL_GATEWAY_API_KEY",
				"GSI_MODEL_CATALOG_URL",
				"BRIGHT_DATA_WEB_UNLOCKER_URL",
				"BRIGHT_DATA_WEB_UNLOCKER_API_KEY",
				"BRIGHT_DATA_ISP_URL",
				"BRIGHT_DATA_ISP_API_KEY",
				"BRIGHT_DATA_SERP_URL",
				"BRIGHT_DATA_SERP_API_KEY",
				"BLOB_READ_WRITE_TOKEN",
				"DATABASE_URL",
				"GITHUB_TOKEN",
				"PERPLEXITY_API_KEY"
			]
		},
		"dev:headless": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"AGENT_BRIDGE_SECRET",
				"GSI_MODEL_GATEWAY_BASE_URL",
				"GSI_MODEL_GATEWAY_API_KEY",
				"GSI_MODEL_CATALOG_URL",
				"BRIGHT_DATA_WEB_UNLOCKER_URL",
				"BRIGHT_DATA_WEB_UNLOCKER_API_KEY",
				"BRIGHT_DATA_ISP_URL",
				"BRIGHT_DATA_ISP_API_KEY",
				"BRIGHT_DATA_SERP_URL",
				"BRIGHT_DATA_SERP_API_KEY",
				"BLOB_READ_WRITE_TOKEN",
				"DATABASE_URL",
				"GITHUB_TOKEN",
				"PERPLEXITY_API_KEY"
			]
		},
		"test": {
			"dependsOn": ["topo", "^build", "@crm/auth#test"],
			"passThroughEnv": ["DATABASE_URL"]
		}
	}
}
